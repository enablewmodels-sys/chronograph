<Project Sdk="Microsoft.NET.Sdk">
  <!-- Conformance harness for the ChronoDB Community .NET client. A console executable,
       never a package: IsPackable is false so no accidental "dotnet pack" publishes it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chronograph/Chronograph.csproj" />
  </ItemGroup>
</Project>
