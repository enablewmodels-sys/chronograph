{
  "name": "chronograph-console",
  "version": "0.4.0-alpha.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test --repeat-each=2",
    "test:protocol": "node ../scripts/protocol-test.mjs",
    "test:latency": "node ../scripts/service-latency.mjs",
    "format": "prettier --write src e2e *.ts *.json ../scripts/*.mjs",
    "format:check": "prettier --check src e2e *.ts *.json ../scripts/*.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
